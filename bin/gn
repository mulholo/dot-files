#!/bin/bash

# Color definitions for improved visuals
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
CYAN="\033[1;36m"
RED="\033[1;31m"
NC="\033[0m" # No Color

echo ""
echo -e "${BLUE}🌙  Cleaning up your environment for the day...${NC}"
echo ""

echo -e "${CYAN}🐳  Stopping Docker processes...${NC}"
docker stop $(docker ps -q)
echo -e "${GREEN}🐳  Docker processes stopped.${NC}"

cd ~/proj/Phoenix

echo -e "${CYAN}🔍  Syncing Phoenix repo...${NC}"
gt sync
echo -e "${GREEN}🔍  Phoenix repo synced.${NC}"
echo ""

echo -e "${GREEN}✅  Cleanup complete.${NC}"
echo -e "${GREEN}🌙  Good night.${NC}"